{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users and their permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "perfil": { "type": "string" },
        "cargo": { "type": "string" },
        "unidade_id": { "type": "number" },
        "status": { "type": "string" },
        "senha": { "type": "string" }
      },
      "required": ["id", "nome", "perfil", "unidade_id", "senha"]
    },
    "Documento": {
      "title": "Documento",
      "description": "Main case files and records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unidade_id": { "type": "number" },
        "origem": { "type": "string" },
        "canal_comunicado": { "type": "string" },
        "data_aporte": { "type": "string" },
        "hora_aporte": { "type": "string" },
        "crianca_nome": { "type": "string" },
        "genitora_nome": { "type": "string" },
        "bairro": { "type": "string" },
        "status": { "type": "array", "items": { "type": "string" } },
        "conselheiro_referencia_id": { "type": "string" }
      },
      "required": ["id", "unidade_id", "origem", "data_aporte", "crianca_nome", "status"]
    },
    "Log": {
      "title": "Log",
      "description": "System audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unidade_id": { "type": "number" },
        "documento_id": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "acao": { "type": "string" },
        "tipo": { "type": "string" },
        "data_hora": { "type": "string" }
      }
    },
    "AgendaEntry": {
      "title": "AgendaEntry",
      "description": "Scheduled appointments and meetings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unidade_id": { "type": "number" },
        "conselheiro_id": { "type": "string" },
        "data": { "type": "string" },
        "hora": { "type": "string" },
        "local": { "type": "string" },
        "tipo": { "type": "string" }
      }
    },
    "ScaleException": {
      "title": "ScaleException",
      "description": "Scale and duty swaps exceptions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "unidade_id": { "type": "number" },
        "conselheiro_original_id": { "type": "string" },
        "conselheiro_original_nome": { "type": "string" },
        "conselheiro_substituto_id": { "type": "string" },
        "conselheiro_substituto_nome": { "type": "string" },
        "justificativa": { "type": "string" },
        "criado_em": { "type": "string" },
        "criado_por_id": { "type": "string" },
        "criado_por_nome": { "type": "string" },
        "inicio_data": { "type": "string" },
        "inicio_hora": { "type": "string" },
        "fim_data": { "type": "string" },
        "fim_hora": { "type": "string" }
      },
      "required": ["id", "data", "unidade_id", "conselheiro_original_id", "conselheiro_substituto_id"]
    },
    "LegalDocument": {
      "title": "LegalDocument",
      "description": "Stored legal norms and documentation for JARVIS knowledge base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "number": { "type": "string" },
        "year": { "type": "string" },
        "authority": { "type": "string" },
        "publicationDate": { "type": "string" },
        "updateDate": { "type": "string" },
        "consultationDate": { "type": "string" },
        "status": { "type": "string", "enum": ["VIGENTE", "ALTERADA", "REVOGADA", "NÃO VERIFICADA"] },
        "sphere": { "type": "string", "enum": ["FEDERAL", "ESTADUAL", "MUNICIPAL", "OUTRO"] },
        "state": { "type": "string" },
        "municipality": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "summary": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" },
        "relevantArticles": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "confidentiality": { "type": "string", "enum": ["PÚBLICO", "INSTITUCIONAL", "RESTRITO", "CONFIDENCIAL"] }
      },
      "required": ["id", "name", "type", "status", "sphere", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user collection"
    },
    "/documents/{docId}": {
      "schema": "Documento",
      "description": "All system documents"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Audit trail"
    },
    "/agenda/{eventId}": {
      "schema": "AgendaEntry",
      "description": "Calendar events"
    },
    "/scale_exceptions/{exceptionId}": {
      "schema": "ScaleException",
      "description": "Duty scale exception swaps"
    },
    "/legal_library/{docId}": {
      "schema": "LegalDocument",
      "description": "Legal documents for JARVIS"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Unit settings and distribution rotation state"
    },
    "/rotation_state/{stateId}": {
      "schema": { "$ref": "#/entities/RotationState" },
      "description": "Legacy rotation state fallback"
    }
  }
}
